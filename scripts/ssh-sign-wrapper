#!/bin/bash
# ssh-sign-wrapper: Resolve a live forwarded or VM-local SSH agent socket and
# delegate to ssh-keygen for git SSH commit signing.
#
# Solves: stale SSH_AUTH_SOCK in zellij/tmux sessions after reconnects.
# Also enforces agent-backed signing (-U) for `ssh-keygen -Y sign`.

set -euo pipefail

RESOLVER="$(dirname "$0")/resolve-vscode-ssh-sock"
SSH_KEYGEN_BIN="$(command -v ssh-keygen)"

key_file=""
prev=""
for arg in "$@"; do
  if [ "$prev" = "-f" ]; then
    key_file="$arg"
    break
  fi
  prev="$arg"
done

required_key=""
if [ -n "$key_file" ] && [ -f "$key_file" ]; then
  required_key="$(awk 'NF {print $1" "$2; exit}' "$key_file" 2>/dev/null || true)"
fi

has_required_key() {
  local sock="$1"
  if [ -z "$required_key" ]; then
    SSH_AUTH_SOCK="$sock" ssh-add -L >/dev/null 2>/dev/null
    return $?
  fi
  SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null | awk 'NF {print $1" "$2}' | grep -Fxq "$required_key"
}

orig_sock="${SSH_AUTH_SOCK-}"
choose_sock=""
if [ -x "$RESOLVER" ]; then
  resolver_args=(--path --prefer "${orig_sock}")
  if [ -n "$key_file" ]; then
    resolver_args+=(--key-file "$key_file")
  fi
  choose_sock="$($RESOLVER "${resolver_args[@]}" 2>/dev/null || true)"
fi

if [ -z "$choose_sock" ] && [ -n "$orig_sock" ] && [ -S "$orig_sock" ] && has_required_key "$orig_sock"; then
  choose_sock="$orig_sock"
fi

if [ -z "$choose_sock" ]; then
  echo "ERROR: SSH agent unavailable. No forwarded or local SSH agent has the signing key." >&2
  if [ -n "$key_file" ]; then
    echo "Hint: reconnect with agent forwarding, or load the fallback key with:" >&2
    echo "  DEVBOX_SSH_AUTH_SOCK=${DEVBOX_SSH_AUTH_SOCK:-$HOME/.ssh/agent.sock} ssh-add ${key_file%.pub}" >&2
  fi
  exit 1
fi
export SSH_AUTH_SOCK="$choose_sock"

has_u=0
is_y_sign=0
prev=""
for arg in "$@"; do
  if [ "$arg" = "-U" ]; then
    has_u=1
  fi
  if [ "$prev" = "-Y" ] && [ "$arg" = "sign" ]; then
    is_y_sign=1
  fi
  prev="$arg"
done

if [ "$is_y_sign" -eq 1 ] && [ "$has_u" -eq 0 ]; then
  rewritten=()
  prev=""
  for arg in "$@"; do
    rewritten+=("$arg")
    if [ "$prev" = "-Y" ] && [ "$arg" = "sign" ]; then
      rewritten+=("-U")
    fi
    prev="$arg"
  done
  exec "$SSH_KEYGEN_BIN" "${rewritten[@]}"
fi

exec "$SSH_KEYGEN_BIN" "$@"
